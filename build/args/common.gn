# Shared by every Perch build. Later files (dev.gn, release.gn) override keys here.
target_cpu = "arm64"
enable_widevine = true
ignore_missing_widevine_signing_cert = true  # until Google issues the VMP certificate (spec 5.2)
proprietary_codecs = true
ffmpeg_branding = "Chrome"
use_official_google_api_keys = false
enable_hangout_services_extension = false
enable_reporting = false
# Chromium builds without Google's branding switch on every experiment in its field-trial testing
# config, features Chrome itself doesn't ship. Perch runs Chromium's shipped defaults instead: it
# measured about 50 MB lighter at idle with one renderer fewer (tools/perf), and is what gets tested upstream.
disable_fieldtrial_testing_config = true
