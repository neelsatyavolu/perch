+// Perch: an agent's group can't be renamed or recoloured while its task runs.
+bool PerchAgentTaskRunsIn(TabSlotController* controller,
+                          const tab_groups::TabGroupId& group) {
+  BrowserWindowInterface* browser = controller->GetBrowserWindowInterface();
+  TabGroup* tab_group = controller->GetTabGroup(group);
+  if (!browser || !tab_group) {
+    return false;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  const gfx::Range range = tab_group->ListTabs();
+  for (uint32_t i = range.start(); i < range.end(); ++i) {
+    if (perch::IsTaskRunningIn(model->GetWebContentsAt(i))) {
+      return true;
+    }
+  }
+  return false;
+}
