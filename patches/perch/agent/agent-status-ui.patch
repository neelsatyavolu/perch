+void AvatarToolbarButton::PaintButtonContents(gfx::Canvas* canvas) {
+  ToolbarButton::PaintButtonContents(canvas);
+  if (!perch::IsAnyChatWaiting() || !GetColorProvider()) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(GetColorProvider()->GetColor(ui::kColorFocusableBorderFocused));
+  const gfx::Rect bounds = GetContentsBounds();
+  canvas->DrawCircle(gfx::PointF(bounds.right() - 4.0f, bounds.y() + 4.0f),
+                     3.0f, flags);
+}
