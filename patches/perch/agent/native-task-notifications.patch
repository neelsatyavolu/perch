# Perch: "waiting for you" notices are system banners on macOS (a PERCH_TASK type; Chromium keeps TRANSIENT ones in its own pop-up).
diff --git a/chrome/browser/notifications/BUILD.gn b/chrome/browser/notifications/BUILD.gn
index a6430a8920..b5aa73c616 100644
--- a/chrome/browser/notifications/BUILD.gn
+++ b/chrome/browser/notifications/BUILD.gn
@@ -85,6 +85,7 @@ source_set("notifications") {
   if (!is_android) {
     public += [
       "glic_actor_task_notification_handler.h",
+      "perch_task_notification_handler.h",
       "muted_notification_handler.h",
       "profile_notification.h",
     ]
@@ -248,6 +249,7 @@ source_set("impl") {
   if (!is_android) {
     sources += [
       "glic_actor_task_notification_handler.cc",
+      "perch_task_notification_handler.cc",
       "muted_notification_handler.cc",
       "profile_notification.cc",
       "screen_capture_notification_blocker.cc",
diff --git a/chrome/browser/notifications/notification_display_service_impl.cc b/chrome/browser/notifications/notification_display_service_impl.cc
index 61915ce03c..e3a6288985 100644
--- a/chrome/browser/notifications/notification_display_service_impl.cc
+++ b/chrome/browser/notifications/notification_display_service_impl.cc
@@ -45,6 +45,7 @@
 
 #if !BUILDFLAG(IS_ANDROID)
 #include "chrome/browser/notifications/glic_actor_task_notification_handler.h"
+#include "chrome/browser/notifications/perch_task_notification_handler.h"
 #include "chrome/browser/notifications/muted_notification_handler.h"
 #include "chrome/browser/notifications/screen_capture_notification_blocker.h"
 #if !BUILDFLAG(IS_CHROMEOS)
@@ -110,6 +111,8 @@ NotificationDisplayServiceImpl::NotificationDisplayServiceImpl(Profile* profile)
     AddNotificationHandler(
         NotificationHandler::Type::GLIC_ACTOR_TASK,
         std::make_unique<GlicActorTaskNotificationHandler>());
+    AddNotificationHandler(NotificationHandler::Type::PERCH_TASK,
+                           std::make_unique<PerchTaskNotificationHandler>());
 
     auto screen_capture_blocker =
         std::make_unique<ScreenCaptureNotificationBlocker>(this);
diff --git a/chrome/browser/notifications/notification_handler.h b/chrome/browser/notifications/notification_handler.h
index 38b83380f6..f4c479be1e 100644
--- a/chrome/browser/notifications/notification_handler.h
+++ b/chrome/browser/notifications/notification_handler.h
@@ -42,7 +42,8 @@ class NotificationHandler {
     DEFAULT_BROWSER_CHANGED = 11,
     EXTENSION_REQUEST = 12,
     GLIC_ACTOR_TASK = 13,
-    MAX = GLIC_ACTOR_TASK,
+    PERCH_TASK = 14,
+    MAX = PERCH_TASK,
   };
 
   virtual ~NotificationHandler();
