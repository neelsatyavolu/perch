+// Perch: what a page reads from an analyser carries this site's
+// fingerprinting factor (perch_farbling.h).
+static void PerchFarble(DOMFloat32Array* array, BaseAudioContext* context) {
+  const float factor =
+      perch::AudioFarblingFactor(context ? context->GetExecutionContext() : nullptr);
+  if (factor == 1.0f || !array) {
