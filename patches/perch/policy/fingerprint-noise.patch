+void AudioBuffer::PerchFarbleOnce() {
+  if (perch_farbled_) {
+    return;
+  }
+  perch_farbled_ = true;
+  const float factor = perch::AudioFarblingFactor(
+      CurrentExecutionContext(v8::Isolate::GetCurrent()));
+  if (factor == 1.0f) {
+    return;
+  }
+  for (auto& channel : channels_) {
+    if (channel) {
+      for (float& sample : channel->AsSpan()) {
+        sample *= factor;
+      }
+    }
+  }
+}
