diff --git a/third_party/blink/renderer/core/html/canvas/perch_farbling.cc b/third_party/blink/renderer/core/html/canvas/perch_farbling.cc
new file mode 100644
index 0000000000..206ca497a2
--- /dev/null
+++ b/third_party/blink/renderer/core/html/canvas/perch_farbling.cc
@@ -0,0 +1,162 @@
+// Copyright 2026 The Perch Authors
+// Use of this source code is governed by the MIT license in Perch's LICENSE file.
+
+#include "third_party/blink/renderer/core/html/canvas/perch_farbling.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/hash/hash.h"
+#include "base/no_destructor.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/frame.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace blink::perch {
+
+namespace {
+
+constexpr char kKeySwitch[] = "perch-farbling-key";
+// About 1 pixel in 40 changes (6 of 256).
+constexpr uint64_t kPixelOdds = 6;
+
+const std::string& Key() {
+  static const base::NoDestructor<std::string> key(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(kKeySwitch));
+  return *key;
+}
+
+uint64_t Mix(uint64_t x) {
+  // splitmix64: a well-spread hash of one 64-bit value.
+  x += 0x9E3779B97F4A7C15ull;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+  return x ^ (x >> 31);
+}
+
+// The site the person sees in the address bar: the top frame's registrable
+// domain, so a site's frames and its embeds on that site agree.
+String SiteOf(const ExecutionContext* context) {
+  const SecurityOrigin* origin = context->GetSecurityOrigin();
+  if (const auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      if (const SecurityContext* top =
+              frame->Tree().Top().GetSecurityContext()) {
+        if (top->GetSecurityOrigin()) {
+          origin = top->GetSecurityOrigin();
+        }
+      }
+    }
+  }
+  if (!origin) {
+    return String();
+  }
+  String site = origin->RegistrableDomain();
+  return site.empty() ? origin->Host() : site;
+}
+
+}  // namespace
+
+std::optional<uint64_t> FarblingSeed(const ExecutionContext* context) {
+  if (!context || Key().empty()) {
+    return std::nullopt;
+  }
+  const std::string site = SiteOf(context).Utf8();
+  const uint64_t high = base::FastHash(Key() + "|" + site);
+  const uint64_t low = base::FastHash(site + "|" + Key());
+  return Mix((high << 32) | low);
+}
+
+void FarbleRgba8(uint8_t* pixels,
+                 size_t row_bytes,
+                 int width,
+                 int height,
+                 bool premultiplied,
+                 uint64_t seed) {
+  if (!pixels || width <= 0 || height <= 0) {
+    return;
+  }
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = UNSAFE_TODO(pixels + y * row_bytes);
+    for (int x = 0; x < width; ++x) {
+      const uint64_t r =
+          Mix(seed ^ (static_cast<uint64_t>(y) * 0x100000001B3ull + x));
+      if ((r & 0xff) >= kPixelOdds) {
+        continue;
+      }
+      uint8_t* pixel = UNSAFE_TODO(row + x * 4);
+      const uint8_t alpha = UNSAFE_TODO(pixel[3]);
+      if (premultiplied && alpha == 0) {
+        continue;
+      }
+      uint8_t& channel = UNSAFE_TODO(pixel[(r >> 8) % 3]);
+      if (channel & 1) {
+        --channel;
+      } else if (!premultiplied || channel + 1 <= alpha) {
+        ++channel;
+      }
+    }
+  }
+}
+
+void FarblePixmap(const SkPixmap& pixmap, const ExecutionContext* context) {
+  const std::optional<uint64_t> seed = FarblingSeed(context);
+  if (!seed || !pixmap.writable_addr() ||
+      (pixmap.colorType() != kRGBA_8888_SkColorType &&
+       pixmap.colorType() != kBGRA_8888_SkColorType)) {
+    return;
+  }
+  FarbleRgba8(static_cast<uint8_t*>(pixmap.writable_addr()),
+              pixmap.rowBytes(), pixmap.width(), pixmap.height(),
+              pixmap.alphaType() == kPremul_SkAlphaType, *seed);
+}
+
+scoped_refptr<StaticBitmapImage> FarbleImage(
+    scoped_refptr<StaticBitmapImage> image,
+    const ExecutionContext* context) {
+  const std::optional<uint64_t> seed = FarblingSeed(context);
+  if (!seed || !image) {
+    return image;
+  }
+  scoped_refptr<StaticBitmapImage> plain = image->MakeUnaccelerated();
+  if (!plain) {
+    return image;
+  }
+  sk_sp<SkImage> source = plain->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source) {
+    return image;
+  }
+  const SkAlphaType alpha = source->alphaType() == kOpaque_SkAlphaType
+                                ? kOpaque_SkAlphaType
+                                : kPremul_SkAlphaType;
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32(
+          source->width(), source->height(), alpha, source->refColorSpace())) ||
+      !source->readPixels(bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+  FarbleRgba8(static_cast<uint8_t*>(bitmap.getPixels()), bitmap.rowBytes(),
+              bitmap.width(), bitmap.height(), alpha == kPremul_SkAlphaType,
+              *seed);
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(bitmap.asImage(),
+                                                plain->Orientation());
+}
+
+float AudioFarblingFactor(const ExecutionContext* context) {
+  const std::optional<uint64_t> seed = FarblingSeed(context);
+  if (!seed) {
+    return 1.0f;
+  }
+  // Between 0.9999 and 0.99999: far below hearing, enough to change a hash.
+  return 1.0f - static_cast<float>((*seed % 900) + 100) * 1e-7f;
+}
+
+}  // namespace blink::perch
