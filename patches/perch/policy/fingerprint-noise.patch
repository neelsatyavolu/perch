+// Copyright 2026 The Perch Authors
+// Use of this source code is governed by the MIT license in Perch's LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_PERCH_FARBLING_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_PERCH_FARBLING_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+class SkPixmap;
+
+namespace blink {
+
+class ExecutionContext;
+class StaticBitmapImage;
+
+// Perch's fingerprinting protection, after Brave's "farbling": what a page
+// reads back from a canvas, WebGL or Web Audio carries a tiny change that is
+// the same for one site for the whole session and different on every other
+// site and every new session, so the readings can't link one person across
+// sites or visits. The browser turns it on by passing each renderer a random
+// key (--perch-farbling-key); without the key nothing changes.
+namespace perch {
+
+// The noise seed for the top-level site of `context` in this session.
+CORE_EXPORT std::optional<uint64_t> FarblingSeed(const ExecutionContext* context);
+
+// Flips the lowest bit of one color channel in about 1 pixel in 40, chosen by
+// `seed`. Alpha is never changed, and premultiplied colors stay valid.
+CORE_EXPORT void FarbleRgba8(uint8_t* pixels,
+                             size_t row_bytes,
+                             int width,
+                             int height,
+                             bool premultiplied,
+                             uint64_t seed);
+
+// The same for an 8-bit RGBA or BGRA pixmap read back for a page.
+CORE_EXPORT void FarblePixmap(const SkPixmap& pixmap,
+                              const ExecutionContext* context);
+
+// A copy of `image` with the noise, for toDataURL and toBlob; `image` itself
+// when farbling is off or the image can't be read.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> FarbleImage(
+    scoped_refptr<StaticBitmapImage> image,
+    const ExecutionContext* context);
+
+// A factor just under 1 that audio samples are multiplied by; 1 when off.
+CORE_EXPORT float AudioFarblingFactor(const ExecutionContext* context);
+
+}  // namespace perch
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_PERCH_FARBLING_H_
