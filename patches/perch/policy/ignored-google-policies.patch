diff --git a/components/policy/core/common/policy_loader_common.h b/components/policy/core/common/policy_loader_common.h
index 7303b43186..502044028f 100644
--- a/components/policy/core/common/policy_loader_common.h
+++ b/components/policy/core/common/policy_loader_common.h
@@ -17,6 +17,10 @@ class PolicyMap;
 // Modifies the |policy| in place. Only call this if the source is untrusted.
 POLICY_EXPORT void FilterSensitivePolicies(PolicyMap* policy);
 
+// Perch: blocks the policies that control Google services Perch does not
+// include, so chrome://policy shows them as ignored and nothing applies them.
+POLICY_EXPORT void FilterGoogleOnlyPolicies(PolicyMap* policy);
+
 // Returns if |policy_name| is in |kSensitivePolicies|
 POLICY_EXPORT bool IsPolicyNameSensitive(const std::string& policy_name);
 
diff --git a/components/policy/core/common/policy_loader_mac.mm b/components/policy/core/common/policy_loader_mac.mm
index e120dc60a1..6f524ff3db 100644
--- a/components/policy/core/common/policy_loader_mac.mm
+++ b/components/policy/core/common/policy_loader_mac.mm
@@ -159,6 +159,8 @@ PolicyBundle PolicyLoaderMac::Load() {
   if (should_filter) {
     FilterSensitivePolicies(&chrome_policy);
   }
+  // Perch: Google-only policies never apply.
+  FilterGoogleOnlyPolicies(&chrome_policy);
 
   return bundle;
 }
