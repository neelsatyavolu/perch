+// Perch: lays the page title out after the host, with a rule between them,
+// while the bar isn't focused and shows a web page's address.
+void LocationBarView::LayoutPerchTitle(const gfx::Rect& location_bounds) {
+  content::WebContents* contents = GetWebContents();
+  const bool web_page =
+      contents && contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() &&
+      contents->GetVisibleURL() == contents->GetLastCommittedURL();
+  const std::u16string title =
+      web_page ? contents->GetTitle() : std::u16string();
+  constexpr int kGap = 12;
+  constexpr int kMinWidth = 48;
+  const int x =
+      location_bounds.x() + omnibox_view_->GetUnelidedTextWidth() + kGap;
+  const int room = location_bounds.right() - x;
+  const bool show = !title.empty() && !omnibox_view_->HasFocus() &&
+                    !omnibox_view_->GetText().empty() && room >= kMinWidth;
+  perch_title_->SetVisible(show);
+  if (!show) {
+    return;
+  }
+  perch_title_->SetText(title);
+  perch_title_->SetFontList(omnibox_view_->GetFontList());
+  const int height = perch_title_->GetPreferredSize().height();
+  perch_title_->SetBounds(
+      x, location_bounds.y() + (location_bounds.height() - height) / 2,
+      std::min(room, perch_title_->GetPreferredSize().width()), height);
+}
