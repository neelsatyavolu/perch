+// Perch: relays a tab's title changes to the bar that shows the title.
+class LocationBarView::PerchTitleWatcher : public content::WebContentsObserver {
+ public:
+  explicit PerchTitleWatcher(LocationBarView* bar) : bar_(bar) {}
+  void Watch(content::WebContents* contents) { Observe(contents); }
