# Perch: each background connection follows its switch in Settings → Privacy (spec 5.1). Hooks ExtensionUpdater::Start/NextCheck, ChromeConfigurator::InitialDelay/NextCheckDelay/UpdateUrl/PingUrl and GetSBProtocolConfig.
diff --git a/chrome/browser/component_updater/chrome_component_updater_configurator.cc b/chrome/browser/component_updater/chrome_component_updater_configurator.cc
index da79189b04..cf41efc2b8 100644
--- a/chrome/browser/component_updater/chrome_component_updater_configurator.cc
+++ b/chrome/browser/component_updater/chrome_component_updater_configurator.cc
@@ -2,6 +2,7 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "chrome/browser/perch/privacy/allowed_connections.h"
 #include "chrome/browser/component_updater/chrome_component_updater_configurator.h"
 
 #include <memory>
@@ -142,11 +143,24 @@ ChromeConfigurator::ChromeConfigurator(const base::CommandLine* cmdline,
 
 base::TimeDelta ChromeConfigurator::InitialDelay() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Perch: with Settings → Privacy → Security and media components off, no
+  // check is scheduled; netaudit starts the first one within seconds.
+  if (!perch::IsConnectionAllowed(perch::Connection::kComponents)) {
+    return base::Days(365);
+  }
+  if (perch::FastTimersForNetaudit()) {
+    return base::Seconds(10);
+  }
   return configurator_impl_.InitialDelay();
 }
 
 base::TimeDelta ChromeConfigurator::NextCheckDelay() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Perch: with the components switch off, the next check waits until the
+  // switch is on again and Perch restarts.
+  if (!perch::IsConnectionAllowed(perch::Connection::kComponents)) {
+    return base::Days(365);
+  }
   return configurator_impl_.NextCheckDelay();
 }
 
@@ -162,11 +176,19 @@ base::TimeDelta ChromeConfigurator::UpdateDelay() const {
 
 std::vector<GURL> ChromeConfigurator::UpdateUrl() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Perch: with the components switch off there is no server to ask, so no
+  // check runs, scheduled or on demand.
+  if (!perch::IsConnectionAllowed(perch::Connection::kComponents)) {
+    return {};
+  }
   return configurator_impl_.UpdateUrl();
 }
 
 std::vector<GURL> ChromeConfigurator::PingUrl() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!perch::IsConnectionAllowed(perch::Connection::kComponents)) {
+    return {};
+  }
   return configurator_impl_.PingUrl();
 }
 
