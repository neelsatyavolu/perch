+#include "chrome/browser/perch/privacy/allowed_connections.h"
 #include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
 #include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
 #include "chrome/browser/profiles/profile.h"
@@ -232,7 +233,10 @@ void ExtensionUpdater::Start() {
   alive_ = true;
   // Check soon, and set up the first delayed check.
   if (!g_skip_scheduled_checks_for_tests) {
-    CheckSoon();
+    // Perch: scheduled checks follow Settings → Privacy → Extension updates.
+    if (perch::IsConnectionAllowed(perch::Connection::kExtensionUpdates)) {
+      CheckSoon();
+    }
     ScheduleNextCheck();
   }
 }
@@ -273,7 +277,10 @@ void ExtensionUpdater::NextCheck() {
   if (!alive_) {
     return;
   }
-  CheckNow(CheckParams());
+  // Perch: scheduled checks follow Settings → Privacy → Extension updates.
+  if (perch::IsConnectionAllowed(perch::Connection::kExtensionUpdates)) {
+    CheckNow(CheckParams());
+  }
   ScheduleNextCheck();
 }
 
