+// Perch: the Ask Perch pill's resting fill.
+void PinnedActionToolbarButton::OnPaintBackground(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (action_id_ == kActionSidePanelShowPerch && colors) {
+    gfx::Rect pill = GetLocalBounds();
+    pill.ClampToCenteredSize(gfx::Size(
+        width(), GetLayoutConstant(LayoutConstant::kToolbarButtonHeight)));
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(
+        colors->GetColor(kColorToolbarButtonBackgroundHighlightedDefault));
+    canvas->DrawRoundRect(gfx::RectF(pill), pill.height() / 2.0f, flags);
+  }
+  ToolbarButton::OnPaintBackground(canvas);
+}
