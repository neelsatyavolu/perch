 VIEW_BUILDER_PROPERTY(const gfx::Insets&, ButtonRowInsets)
 END_VIEW_BUILDER
 
+// Perch: whether `view` sits in a bubble Perch frosts on Mac (see
+// BubbleDialogDelegate::CreateBubbleInternal). Opaque dialog fills inside such
+// a bubble would cover the glass.
+VIEWS_EXPORT bool IsInPerchGlassBubble(const View* view);
+
 }  // namespace views
 
 DEFINE_VIEW_BUILDER(VIEWS_EXPORT, BubbleDialogDelegateView)
