# Perch: in a frosted-glass bubble, scroll views paint no opaque dialog fill and the footer is a faint ink band, so the glass shows throughout.
diff --git a/ui/views/bubble/bubble_dialog_delegate_view.cc b/ui/views/bubble/bubble_dialog_delegate_view.cc
index afbc09c28e..8fa4942766 100644
--- a/ui/views/bubble/bubble_dialog_delegate_view.cc
+++ b/ui/views/bubble/bubble_dialog_delegate_view.cc
@@ -1482,4 +1482,17 @@ void BubbleDialogDelegate::UpdateHighlightedButton(bool highlighted) {
 BEGIN_METADATA(BubbleDialogDelegateView)
 END_METADATA
 
+bool IsInPerchGlassBubble(const View* view) {
+#if BUILDFLAG(IS_MAC)
+  Widget* widget = view ? const_cast<View*>(view)->GetWidget() : nullptr;
+  WidgetDelegate* delegate = widget ? widget->widget_delegate() : nullptr;
+  BubbleDialogDelegate* bubble =
+      delegate ? delegate->AsBubbleDialogDelegate() : nullptr;
+  return bubble && bubble->GetShadow() == BubbleBorder::NO_SHADOW &&
+         bubble->background_color() == ui::kColorMenuBackground;
+#else
+  return false;
+#endif
+}
+
 }  // namespace views
