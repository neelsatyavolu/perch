+
 void FootnoteContainerView::SetRoundedBackground(float lower_left_radius,
                                                  float lower_right_radius) {
+  lower_left_radius_ = lower_left_radius;
+  lower_right_radius_ = lower_right_radius;
+  // Perch: in a frosted-glass bubble the footer is a faint ink band over the
+  // glass, not an opaque card-coloured block.
   SetBackground(CreateRoundedRectBackground(
