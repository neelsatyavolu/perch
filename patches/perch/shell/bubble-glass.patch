# Perch: bubbles on Mac get the menus' frosted material, and labels draw without subpixel text.
diff --git a/ui/views/bubble/bubble_dialog_delegate_view.cc b/ui/views/bubble/bubble_dialog_delegate_view.cc
index 53e90715ea..e4279771a5 100644
--- a/ui/views/bubble/bubble_dialog_delegate_view.cc
+++ b/ui/views/bubble/bubble_dialog_delegate_view.cc
@@ -69,6 +69,7 @@
 #endif
 
 #if BUILDFLAG(IS_MAC)
+#include "ui/views/controls/menu/menu_host_glass_mac.h"
 #include "ui/views/widget/widget_utils_mac.h"
 #else
 #include "ui/aura/window.h"
@@ -558,8 +559,26 @@ Widget* BubbleDialogDelegate::CreateBubbleInternal(
     delegate->SetAnchorView(anchor_view);
   }
 
+#if BUILDFLAG(IS_MAC)
+  // Perch: bubbles that macOS shadows are frosted like the menus, a thin tint
+  // over the system material (see menu_host_glass_mac.mm).
+  const bool perch_glass =
+      delegate->GetShadow() == BubbleBorder::NO_SHADOW &&
+      (delegate->background_color() == ui::kColorBubbleBackground ||
+       delegate->background_color() == ui::kColorMenuBackground);
+  if (perch_glass) {
+    delegate->SetBackgroundColor(ui::kColorMenuBackground);
+  }
+#endif
+
   Widget* const bubble_widget = CreateBubbleWidget(delegate, ownership);
 
+#if BUILDFLAG(IS_MAC)
+  if (perch_glass) {
+    ApplyPerchMenuGlass(bubble_widget, delegate->GetCornerRadius());
+  }
+#endif
+
   delegate->SizeToContents();
   delegate->bubble_widget_observer_ =
       std::make_unique<BubbleWidgetObserver>(delegate, bubble_widget);
diff --git a/ui/views/controls/label.cc b/ui/views/controls/label.cc
index 5c044c673c..a092b7c24c 100644
--- a/ui/views/controls/label.cc
+++ b/ui/views/controls/label.cc
@@ -1545,8 +1545,14 @@ void Label::ApplyTextColors() const {
   display_text_->set_selection_background_focused_color(
       selection_background_color_);
 
+  // Perch: macOS text has no subpixel rendering, and frosted menus and bubbles
+  // put labels on a translucent fill.
+#if BUILDFLAG(IS_MAC)
+  const bool subpixel_rendering_enabled = false;
+#else
   const bool subpixel_rendering_enabled =
       subpixel_rendering_enabled_ && IsOpaque(GetBackgroundColor());
+#endif
   display_text_->set_subpixel_rendering_suppressed(!subpixel_rendering_enabled);
 }
 
