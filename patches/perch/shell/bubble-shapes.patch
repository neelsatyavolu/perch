 void BubbleBorder::PaintNoShadow(const View& view, gfx::Canvas* canvas) {
-  gfx::ScopedCanvas scoped(canvas);
-  canvas->sk_canvas()->clipRRect(GetClientRect(view), SkClipOp::kDifference,
-                                 true /*doAntiAlias*/);
-  canvas->sk_canvas()->drawColor(SkColors::kTransparent, SkBlendMode::kSrc);
+  {
+    gfx::ScopedCanvas scoped(canvas);
+    canvas->sk_canvas()->clipRRect(GetClientRect(view), SkClipOp::kDifference,
+                                   true /*doAntiAlias*/);
+    canvas->sk_canvas()->drawColor(SkColors::kTransparent, SkBlendMode::kSrc);
+  }
+#if BUILDFLAG(IS_MAC)
+  // Perch: macOS draws the bubble's shadow, so the edge is a hairline here.
+  if (const ui::ColorProvider* colors = view.GetColorProvider()) {
+    SkRRect edge = GetClientRect(view);
+    edge.inset(0.5f, 0.5f);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.0f);
+    flags.setColor(colors->GetColor(ui::kColorBubbleBorder));
+    canvas->sk_canvas()->drawRRect(edge, flags);
+  }
+#endif
 }
 
