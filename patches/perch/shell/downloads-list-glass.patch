+
+void DownloadBubbleRowView::ClipLabelsToQuickActions() {
+  const bool shown = quick_action_holder_->GetVisible();
+  for (views::Label* label : {primary_label_.get(), secondary_label_.get()}) {
+    if (!label) {
+      continue;
+    }
+    if (!shown) {
+      label->SetClipPath(SkPath());
+      continue;
+    }
+    const int width = std::max(0, quick_action_holder_->x() - label->x());
+    label->SetClipPath(
+        SkPath::Rect(SkRect::MakeWH(width, label->height())));
+  }
 }
 
