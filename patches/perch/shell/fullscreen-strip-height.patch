# Perch: in full screen the tab strip window ends where the active tab's fill ends, so no line shows above the toolbar.
diff --git a/chrome/browser/ui/views/frame/immersive_mode_controller_mac.mm b/chrome/browser/ui/views/frame/immersive_mode_controller_mac.mm
index 34b52a6fd0..2bc749236c 100644
--- a/chrome/browser/ui/views/frame/immersive_mode_controller_mac.mm
+++ b/chrome/browser/ui/views/frame/immersive_mode_controller_mac.mm
@@ -2,6 +2,7 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "chrome/browser/ui/layout_constants.h"
 #include "chrome/browser/ui/views/frame/immersive_mode_controller_mac.h"
 
 #include <AppKit/AppKit.h>
@@ -104,7 +105,17 @@ void ImmersiveModeControllerMac::SetEnabled(bool enabled) {
     // Vertical tab strip should stay visible and will not be reparented to the
     // tab overlay.
     if (separate_tab_strip_ && !browser_view_->ShouldDrawVerticalTabStrip()) {
-      tab_widget_height_ = browser_view_->tab_strip_view()->height();
+      // Perch: in a window the toolbar covers the strip's bottom rows (the
+      // tab/toolbar overlap), and the active tab's fill stops above them.
+      // Here the strip stands alone in its own window, so it ends where the
+      // tab's fill ends; otherwise those rows show as a line above the
+      // toolbar.
+      tab_widget_height_ =
+          GetLayoutConstant(LayoutConstant::kTabStripHeight) -
+          GetLayoutConstant(LayoutConstant::kTabstripToolbarOverlap);
+      LOG(WARNING) << "Perch fullscreen: tab strip window " << tab_widget_height_
+                   << " (strip view " << browser_view_->tab_strip_view()->height()
+                   << ")";
       tab_widget_height_ += static_cast<BrowserFrameViewMac*>(
                                 browser_view_->browser_widget()->GetFrameView())
                                 ->GetTopInset(false);
@@ -373,8 +384,11 @@ void ImmersiveModeControllerMac::OnViewBoundsChanged(
     gfx::Size new_size(bounds.width(), tab_widget_height_);
     browser_view_->tab_overlay_widget()->SetSize(new_size);
     browser_view_->tab_overlay_view()->SetSize(new_size);
+    // The strip view keeps its own height; its window crops the rows the
+    // toolbar would cover.
     browser_view_->tab_strip_view()->SetBoundsRect(gfx::Rect(gfx::Size(
-        new_size.width(), browser_view_->tab_strip_view()->height())));
+        new_size.width(),
+        GetLayoutConstant(LayoutConstant::kTabStripHeight))));
     overlay_height_ += tab_widget_height_;
   }
   browser_view_->overlay_widget()->SetSize(bounds.size());
