+void MemorySaverModePolicy::SetPerchTimeBeforeDiscard(base::TimeDelta time) {
+  if (perch_time_before_discard_ == time) {
+    return;
+  }
+  perch_time_before_discard_ = time;
+  if (memory_saver_mode_enabled_) {
+    active_discard_timers_.clear();
+    StartAllDiscardTimers();
+  }
+}
