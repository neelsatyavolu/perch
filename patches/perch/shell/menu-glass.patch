diff --git a/ui/views/controls/menu/menu_config_mac.mm b/ui/views/controls/menu/menu_config_mac.mm
index 5701640302..84941b0d58 100644
--- a/ui/views/controls/menu/menu_config_mac.mm
+++ b/ui/views/controls/menu/menu_config_mac.mm
@@ -12,14 +12,16 @@ void MenuConfig::InitPlatform() {
   use_mnemonics = false;
   show_context_menu_accelerators = false;
   all_menus_use_prefix_selection = true;
-  // Perch: the menus Chromium still draws (bookmark folders and the like)
-  // follow DESIGN.md: 6px rows inside an 8px menu, with tight separators.
-  item_corner_radius = 6;
+  // Perch: frosted 12px menus (see menu_host_glass_mac.mm) with 8px rows
+  // inset 6px from the edge and tight separators (DESIGN.md).
+  item_corner_radius = 8;
   item_vertical_margin = 6;
   separator_height = 9;
   separator_upper_height = 4;
   separator_lower_height = 4;
-  corner_radius = 8;
+  corner_radius = 12;
+  rounded_menu_vertical_border_size = 6;
+  menu_horizontal_border_size = 6;
 }
 
 }  // namespace views
