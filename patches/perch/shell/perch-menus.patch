# Perch: the menu button opens Perch's own menu, and Settings opens Perch's settings.
diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 13177b64ca..ec9e86dc4f 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -2,6 +2,7 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "chrome/browser/perch/perch_command_ids.h"
 #include "chrome/browser/perch/perch_commands.h"
 #include "chrome/browser/ui/browser_command_controller.h"
 
@@ -1353,7 +1354,9 @@ void BrowserCommandController::HandleCommandWithDisposition(
                           chrome::kPerformanceSubPage);
       break;
     case IDC_OPTIONS:
-      ShowSettings(webui::GetBrowserForOpeningWebUi(browser_));
+      // Perch: Settings (and ⌘,) open Perch's settings; Chromium's stay at
+      // chrome://settings for the few things only they cover.
+      perch::ExecutePerchCommand(browser_, IDC_PERCH_OPEN_SETTINGS);
       break;
     case IDC_EDIT_SEARCH_ENGINES:
       ShowSearchEngineSettings(webui::GetBrowserForOpeningWebUi(browser_));
