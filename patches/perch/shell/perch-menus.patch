 #include "chrome/browser/ui/views/toolbar/browser_app_menu_button.h"
 
+#include "chrome/browser/perch/toolbar/perch_profile_menu.h"
+
 #include <set>
 
 #include "base/feature_list.h"
@@ -96,6 +98,11 @@ void BrowserAppMenuButton::ShowMenuWithFlags(int run_types) {
 
   BrowserWindowInterface* browser = toolbar_view_->browser();
 
+  // Perch: the menu button opens Perch's own menu.
+  if (perch::ShowPerchAppMenu(browser, this)) {
+    return;
