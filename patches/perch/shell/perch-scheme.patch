# Perch: perch:// addresses. Registers the scheme as standard (chrome_content_client.cc) and adds a BrowserURLHandler pair in BrowserURLHandlerCreated: perch://x opens chrome://x (perch://settings is chrome://perch-settings) and Perch's pages show as perch://.
diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index 5c123e8505..2f53a8670f 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -1004,6 +1004,10 @@ source_set("core") {
     "after_startup_task_utils.cc",
     "browser_about_handler.cc",
     "browser_process_impl.cc",
+
+    # Perch: perch:// addresses.
+    "//chrome/browser/perch/scheme/perch_scheme.cc",
+    "//chrome/browser/perch/scheme/perch_scheme.h",
     "chrome_browser_field_trials.cc",
     "chrome_browser_interface_binders.cc",
     "chrome_browser_interface_binders.h",
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 565bd580ba..701df73c39 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -69,6 +69,7 @@
 #include "chrome/browser/bluetooth/chrome_bluetooth_delegate.h"
 #include "chrome/browser/bluetooth/chrome_bluetooth_delegate_impl_client.h"
 #include "chrome/browser/browser_about_handler.h"
+#include "chrome/browser/perch/scheme/perch_scheme.h"
 #include "chrome/browser/browser_features.h"
 #include "chrome/browser/browser_process.h"
 #include "chrome/browser/browsing_data/chrome_browsing_data_model_delegate.h"
@@ -5237,6 +5238,10 @@ void ChromeContentBrowserClient::BrowserURLHandlerCreated(
     part->BrowserURLHandlerCreated(handler);
   }
 
+  // Perch: perch:// addresses open chrome:// pages, and Perch's own pages
+  // show as perch://.
+  handler->AddHandlerPair(&perch::RewritePerchURL, &perch::ReversePerchURL);
+
   // Handler to rewrite chrome://about and chrome://sync URLs.
   handler->AddHandlerPair(&HandleChromeAboutAndChromeSyncRewrite,
                           BrowserURLHandler::null_handler());
diff --git a/chrome/common/chrome_content_client.cc b/chrome/common/chrome_content_client.cc
index 601ff3ce61..634d6841cd 100644
--- a/chrome/common/chrome_content_client.cc
+++ b/chrome/common/chrome_content_client.cc
@@ -205,6 +205,8 @@ static const char* const kChromeStandardURLSchemes[] = {
 void ChromeContentClient::AddAdditionalSchemes(Schemes* schemes) {
   for (auto* standard_scheme : kChromeStandardURLSchemes)
     schemes->standard_schemes.push_back(standard_scheme);
+  // Perch: perch:// addresses, rewritten to chrome:// before they load.
+  schemes->standard_schemes.push_back("perch");
 
 #if BUILDFLAG(IS_ANDROID)
   schemes->referrer_schemes.push_back(content::kAndroidAppScheme);
