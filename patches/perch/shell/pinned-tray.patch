+// Perch: pinned tabs sit together in one rounded tray, a faint fill with a
+// hairline edge, drawn under the tabs.
+void TabContainer::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  gfx::Rect tray;
+  for (int i = 0; i < GetTabCount(); ++i) {
+    const Tab* tab = GetTabAtModelIndex(i);
+    if (tab && tab->data().pinned && tab->GetVisible() && !tab->closing()) {
+      tray.Union(tab->bounds());
+    }
+  }
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (tray.IsEmpty() || !colors) {
+    return;
+  }
+  gfx::RectF edge(tray);
+  edge.Inset(gfx::InsetsF::TLBR(5.5f, 4.5f, 5.5f, 4.5f));
+  const SkColor ink = colors->GetColor(kColorTabForegroundActiveFrameActive);
+  constexpr float kRadius = 10;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(SkColorSetA(ink, 0x12));
+  canvas->DrawRoundRect(edge, kRadius, flags);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(1);
+  flags.setColor(SkColorSetA(ink, 0x24));
+  canvas->DrawRoundRect(edge, kRadius, flags);
+}
