 #include <stdint.h>
@@ -504,6 +505,13 @@ WindowsCreateFunction::WindowsCreateFunction() = default;
 WindowsCreateFunction::~WindowsCreateFunction() = default;
 
 ExtensionFunction::ResponseAction WindowsCreateFunction::Run() {
+  // Perch: during setup, extensions brought over by the import open their
+  // welcome pages as they install; those wait. A tab the person asked for
+  // (a click in the extension, with a user gesture) still opens.
+  if (!user_gesture() && perch::ExtensionTabsHeldBack(
+                             Profile::FromBrowserContext(browser_context()))) {
+    return RespondNow(Error("Perch is finishing setup; try again in a few minutes"));
+  }
   std::optional<windows::Create::Params> params =
       windows::Create::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
