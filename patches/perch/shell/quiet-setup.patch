Keeps first run quiet: tabs and windows that extensions open on their own (welcome pages as an import's extensions install) wait while setup runs and for a few minutes after (perch::ExtensionTabsHeldBack), and the Continue where you left off bar never shows, since Perch always reopens tabs.
diff --git a/chrome/browser/extensions/api/tabs/tabs_api.cc b/chrome/browser/extensions/api/tabs/tabs_api.cc
index de78a212cd..c479eb87db 100644
--- a/chrome/browser/extensions/api/tabs/tabs_api.cc
+++ b/chrome/browser/extensions/api/tabs/tabs_api.cc
@@ -2,6 +2,7 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "chrome/browser/perch/onboarding/onboarding.h"
 #include "chrome/browser/extensions/api/tabs/tabs_api.h"
 
 #include "base/memory/weak_ptr.h"
@@ -853,6 +854,13 @@ ExtensionFunction::ResponseAction TabsCreateFunction::Run() {
   std::optional<tabs::Create::Params> params =
       tabs::Create::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
+  // Perch: during setup, extensions brought over by the import open their
+  // welcome pages as they install; those wait. A tab the person asked for
+  // (a click in the extension, with a user gesture) still opens.
+  if (!user_gesture() && perch::ExtensionTabsHeldBack(
+                             Profile::FromBrowserContext(browser_context()))) {
+    return RespondNow(Error("Perch is finishing setup; try again in a few minutes"));
+  }
 
   const tabs::Create::Params::CreateProperties& create_properties =
       params->create_properties;
