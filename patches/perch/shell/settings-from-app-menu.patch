 void ShowSettings(BrowserWindowInterface* browser) {
+  // Perch: Settings opens Perch's settings, including from the app menu and
+  // ⌘, (which reach here through AppController, not IDC_OPTIONS). Chromium's
+  // sub-pages stay at chrome://settings.
+  if (perch::ExecutePerchCommand(browser, IDC_PERCH_OPEN_SETTINGS)) {
+    return;
+  }
   ShowSettingsSubPage(browser, std::string());
 }
 
