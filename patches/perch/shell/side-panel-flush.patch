+// Perch: the panel's 1px edge is painted as a hairline in the separator
+// colour so it meets the toolbar's bottom rule, rather than showing whatever
+// is behind the panel. `top_inset` is the unpainted space for the header.
+std::unique_ptr<views::Border> CreatePerchPanelBorder(int top_inset) {
+  return views::CreatePaddedBorder(
+      views::CreateSolidSidedBorder(GetBorderInsets().set_top(0),
+                                    kColorSidePanelContentAreaSeparator),
+      gfx::Insets::TLBR(top_inset, 0, 0, 0));
+}
