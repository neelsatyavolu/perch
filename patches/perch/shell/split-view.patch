+// Perch: the split divider is a hairline in the strong separator colour.
+void MultiContentsResizeArea::OnPaint(gfx::Canvas* canvas) {
+  ResizeArea::OnPaint(canvas);
+  const gfx::Rect bounds = GetLocalBounds();
+  const gfx::Rect line =
+      axis() == Axis::kHorizontal
+          ? gfx::Rect(bounds.CenterPoint().x(), 0, 1, bounds.height())
+          : gfx::Rect(0, bounds.CenterPoint().y(), bounds.width(), 1);
+  canvas->FillRect(line, GetColorProvider()->GetColor(kColorToolbarSeparator));
+}
