 void OmniboxEditModel::OnTabPressed(bool shift) {
+  // Perch: Tab switches a typed search between Brave and Google.
+  if (perch::HandleTabForGoogle(
+          this, controller_->client()->GetTemplateURLService(),
+          controller_->client()->GetSchemeClassifier(), shift)) {
+    return;
+  }
   const OmniboxPopupSelection::Direction direction =
       shift ? OmniboxPopupSelection::Direction::kBackward
             : OmniboxPopupSelection::Direction::kForward;
