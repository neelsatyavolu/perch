# Copy to scripts/maintainer.local (git ignores it). Only signed packages and releases need this;
# everyone else packages with: uv run perch-build package --mode adhoc
# The 1Password account that holds the Developer ID certificate (its user ID when several accounts share a host).
export OP_ACCOUNT=""
export AGMUX_APPLE_SIGNING_VAULT=""
export AGMUX_APPLE_NOTARY_VAULT=""
# e.g. "Developer ID Application: Your Name (TEAMID)"
export PERCH_SIGNING_IDENTITY=""
# 1Password reference to the Sparkle EdDSA private key, e.g. "op://Vault/Item/password"
export PERCH_SPARKLE_KEY_REF=""
