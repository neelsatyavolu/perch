// perchbrowser.com landing page. Static files in public/, served through src/worker.js so
// every response gets the security headers and www redirects to the apex.
// Deploy (owner approval only): cd site && bun install && bunx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perch-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "perchbrowser.com", "custom_domain": true },
    { "pattern": "www.perchbrowser.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
