{
  "name": "perch-ui-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perch's own pages: new tab, Settings, Memory, Routines, Import and Welcome",
  "license": "MIT",
  "scripts": {
    "dev": "vite --mode fake",
    "build": "vite build",
    "build:fake": "vite build --mode fake --outDir dist-fake",
    "test": "bun run test:unit && bun run test:smoke",
    "test:unit": "bun test --preload ./test/setup-dom.ts test/unit test/components",
    "test:smoke": "bun test test/smoke",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.2.5",
    "@fontsource/geist-sans": "5.2.5",
    "lucide-preact": "0.525.0",
    "preact": "10.26.9"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "18.0.1",
    "@preact/preset-vite": "2.10.1",
    "@testing-library/preact": "3.2.4",
    "@types/bun": "1.3.10",
    "happy-dom": "18.0.1",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  }
}
